# ── Pulse — Environment Variables ────────────────────────────
# This app runs 100% OFFLINE. No API keys required.
# All inference happens on-device via @qvac/sdk.

# ── QVAC (Optional — for development) ───────────────────────
# If you have a QVAC development server running locally:
# QVAC_DEV_SERVER=http://localhost:8080

# ── Demo Mode ────────────────────────────────────────────────
# Set to "true" to use mock data instead of real @qvac/sdk inference
# PULSE_DEMO=true
